# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://carlspat:carlspat_dev_password@localhost:5432/carlspat_sms?schema=public

# Minimum 32 characters each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Seed the database automatically on boot (used by docker-compose)
SEED_ON_START=false

# ── File storage (Cloudinary) — optional; falls back to local ./uploads ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_CALLBACK_URL=http://localhost:3000/dashboard/fees

# ── Notifications — optional; logged to console when unset ───────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=carlspatprivateschool@outlook.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
